# Vercel AI Gateway API key. Get one at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
# This is the recommended way to authenticate model calls in this project.
AI_GATEWAY_API_KEY=

# Alternative: call Anthropic directly instead of through the AI Gateway.
# The AI SDK will use this automatically if AI_GATEWAY_API_KEY is not set
# and the model string resolves to an Anthropic model.
ANTHROPIC_API_KEY=

# Optional: override the default model (must support tool calling).
# Defaults to "anthropic/claude-sonnet-5" if unset.
TRIAGE_MODEL=anthropic/claude-sonnet-5
